using Spectre.Console;
using System;
using System.Linq;
using static System.Runtime.InteropServices.JavaScript.JSType;
using GTranslate.Translators;

namespace Hildur4._0
{
    public class WelcomeUI
    {
        /// <summary>
        /// Show a simple welcome UI with three choices using Spectre.Console.
        /// Returns the selected option as a string.
        /// </summary>
        public string UserInterface()
        {
            Console.OutputEncoding = System.Text.Encoding.Unicode;
            AnsiConsole.Clear();

            var art = "          #******#          \n      ****************      \n    +*******************    \n  ************************  \n  ************************  \n  ******    +***    ******  \n#*******    +**+    *******#\n#*******----****----*******#\n#**************************#\n#***++++****++++****++++***#\n#***.   #***    ****    ***#\n#*. +***    +**+    ***+ .*#\n#**************************#\n#***  ******    ******  ***#\n#*      ****    ****      *#";

            var messages = new[]
            {
                "Welcome, guest — please leave your past at the door.",
                "Afterlife Hotel: reservations are forever.",
                "Rooms with a view of eternity. Relax and roam.",
                "The lobby between heartbeats welcomes you.",
                "Make yourself at home among the stars."
            };

            var random = new Random();
            var message = messages[random.Next(messages.Length)];

            // Escape message and art, then wrap entire art in blue markup
            var escapedMessage = Markup.Escape(message);
            var escapedArt = Markup.Escape(art);

            var markupContent = $"{escapedMessage}\n\n[blue]{escapedArt}[/]";

            // Render a larger title using FigletText, then show panel with message and blue art
            var figlet = new FigletText("Welcome To The Hjortronet Hotel").Color(Color.Cyan).Centered();
            AnsiConsole.Write(figlet);

            var panel = new Panel(new Markup(markupContent))
                .Padding(1, 1)
                .Border(BoxBorder.Rounded);

            // Center the panel using Align with HorizontalAlignment
            AnsiConsole.Write(new Align(panel, HorizontalAlignment.Center));

            var choices = new[] { "Booking", "Check-in", "Checkout" };

            int selected = 0;

            void RenderMenu()
            {
                AnsiConsole.Clear();
                AnsiConsole.Write(figlet);
                AnsiConsole.Write(new Align(panel, HorizontalAlignment.Center));

                int winW = 80;
                try { winW = Console.WindowWidth; } catch { }

                var artLines = art.Split('\n');
                int contentWidth = Math.Max(message.Length, artLines.Max(l => l.Length));
                int panelWidth = contentWidth + 4; // padding + borders

                int leftPad = Math.Max(0, (winW - panelWidth) / 2);

                Console.WriteLine();
                for (int i = 0; i < choices.Length; i++)
                {
                    var prefix = i == selected ? ">" : " ";
                    if (i == selected)
                        AnsiConsole.MarkupLine(new string(' ', leftPad) + $"[yellow]{prefix} {choices[i]}[/]");
                    else
                        Console.WriteLine(new string(' ', leftPad) + $"  {choices[i]}");
                }

                Console.WriteLine();
                Console.Write(new string(' ', leftPad) + "Use ↑/↓ to select, Press [Enter] to confirm");
            }

            ConsoleKey key;
            do
            {
                RenderMenu();
                var k = Console.ReadKey(true);
                key = k.Key;
                if (key == ConsoleKey.UpArrow)
                {
                    selected = (selected - 1 + choices.Length) % choices.Length;
                }
                else if (key == ConsoleKey.DownArrow)
                {
                    selected = (selected + 1) % choices.Length;
                }
            } while (key != ConsoleKey.Enter);

            var choice = choices[selected];

            // Print selected centered under the panel
            try
            {
                int winW = Console.WindowWidth;
                var artLines = art.Split('\n');
                int contentWidth = Math.Max(message.Length, artLines.Max(l => l.Length));
                int panelWidth = contentWidth + 4;
                int leftPad = Math.Max(0, (winW - panelWidth) / 2);
                Console.SetCursorPosition(leftPad, Console.CursorTop);
            }
            catch { }

            AnsiConsole.MarkupLine($"\n[green]Selected:[/] {choice}\n");
            return choice;
        }
    }
}
